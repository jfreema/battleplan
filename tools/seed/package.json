{
  "name": "battleplan-seed",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=demo-battleplan tsx seed.ts",
    "super-admin": "tsx set-super-admin.ts",
    "demo": "tsx demo.ts",
    "demo:emulators": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 tsx demo.ts --project demo-battleplan",
    "store-shots": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 GCLOUD_PROJECT=demo-battleplan tsx store-shots.ts",
    "test": "tsx --test demo.test.ts migrate-one-type.test.ts",
    "migrate-one-type": "tsx migrate-one-type.ts",
    "test:emulators": "firebase emulators:exec --only firestore --project demo-battleplan 'npm test'"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
