rules_version = '2';

// Storage rules (ARCH §6.3, §6.11). Membership is checked against Firestore
// with cross-service rules. Every upload under groups/{g}/ needs underQuota:
// a full team can't add photos, documents, a logo, or a background (STORE-4).
// No file is larger than 10 MB (STORE-1, Limits.maxUploadMb and maxImageMb).
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function team(g) { return firestore.get(/databases/(default)/documents/groups/$(g)).data; }
    // As in firestore.rules: members of a suspended team lose the team
    // (ADMIN-3), files included. A rule reads at most two Firestore
    // documents, so every check here uses only the membership and the team.
    function isMember(g) {
      return signedIn() && firestore.exists(
        /databases/(default)/documents/groupMembers/$(g + '_' + request.auth.uid))
        && team(g).get('suspendedAt', null) == null;
    }
    function isAdmin(g) {
      return isMember(g) && firestore.get(
        /databases/(default)/documents/groupMembers/$(g + '_' + request.auth.uid)).data.role
        in ['owner', 'admin'];
    }
    function superAdmin() { return signedIn() && request.auth.token.get('superAdmin', false) == true; }
    // Super admins read every team's files without joining ("View team",
    // ADMIN-3, and Media). The only files they upload into a team they
    // aren't on are its logo and chat background (ADMIN-3 Edit), which
    // adminUpdateGroup then saves; they never post photos or documents.
    // A direct conversation's photos (CHAT-19) are only its two people's.
    function canRead(g) {
      return (superAdmin() && team(g).get('kind', 'team') != 'direct') || isMember(g);
    }
    // The same test as Firestore rules' hasRoom (STORE-4), on an active
    // team: archived teams are read-only (TEAM-9), so nothing uploads there.
    function underQuota(g) {
      let group = team(g);
      return group.storageBytes < group.storageQuotaBytes
        && group.get('archivedAt', null) == null;
    }
    function isImage(maxMb) {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size <= maxMb * 1024 * 1024;
    }
    function isDocument(maxMb) {
      return request.resource.size <= maxMb * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType in [
              'application/pdf', 'text/plain', 'text/csv',
              'application/msword',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
              'application/vnd.ms-excel',
              'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
              'application/vnd.ms-powerpoint',
              'application/vnd.openxmlformats-officedocument.presentationml.presentation'
            ]);
    }

    // Who uploaded a team logo or chat background, for Media (STORE-5): the
    // app tags it with uploadedBy, which may only name the uploader.
    function uploaderOk() {
      return request.resource.metadata == null
        || request.resource.metadata.get('uploadedBy', request.auth.uid) == request.auth.uid;
    }

    match /users/{uid}/avatar/{file} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && isImage(10);
    }
    match /groups/{g}/avatar/{file} {
      allow read: if canRead(g);
      allow write: if (superAdmin() || isAdmin(g)) && isImage(10) && underQuota(g) && uploaderOk();
    }
    // The chat background photo (CHAT-18), set by the team's admins (or a
    // super admin, ADMIN-3).
    match /groups/{g}/theme/{file} {
      allow read: if canRead(g);
      allow write: if (superAdmin() || isAdmin(g)) && isImage(10) && underQuota(g) && uploaderOk();
    }
    match /groups/{g}/messages/{messageId}/{allPaths=**} {
      allow read: if canRead(g);
      allow create: if isMember(g) && isImage(10) && underQuota(g);
    }
    // A document's file (DOC-2), uploaded before its groupDocuments record,
    // which must name this path. A team that never set membersCanUploadDocs
    // lets members upload (TEAM-5's default), as the Firestore rule does;
    // super admins on the team always may (§3).
    // No client deletes: deleting the document removes the file
    // (onDocumentDeleted), and dailyCleanup removes uploads whose document
    // was never created.
    match /groups/{g}/documents/{docId}/{file} {
      allow read: if canRead(g);
      allow create: if isMember(g) && underQuota(g) && isDocument(10)
        && (superAdmin() || isAdmin(g)
            || team(g).settings.get('membersCanUploadDocs', true) == true);
    }
  }
}
