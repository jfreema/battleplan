{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Battleplan",
        "supportEmail": "battleplan-help@googlegroups.com"
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "*.log",
        "src"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "build/hosting",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/join",
        "destination": "/app/join",
        "type": 302
      },
      {
        "source": "/join/:code",
        "destination": "/app/join/:code",
        "type": 302
      },
      {
        "source": "/activate",
        "destination": "/app/activate",
        "type": 302
      },
      {
        "source": "/emaillogin",
        "destination": "/app/emaillogin",
        "type": 302
      },
      {
        "source": "/g/:rest*",
        "destination": "/app/g/:rest*",
        "type": 302
      },
      {
        "source": "/ios",
        "destination": "/",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/cal/**",
        "function": {
          "functionId": "calendarFeed",
          "region": "us-central1"
        }
      },
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/app{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "regex": "^/.+\\.[0-9a-f]{8,}\\.(css|js|mjs|wasm|png|jpe?g|webp|avif|svg|woff2?)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "hosting": {
      "port": 5002
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
